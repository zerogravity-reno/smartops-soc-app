.smartops/

# Scaffolding left behind by orchestrator agents. Briefings and progress files
# from runs that were killed mid-flight; kept on disk for post-mortems, never
# source.
.agents/

# Subagent-driven-development ledgers and review packages, per plan.
.superpowers/
