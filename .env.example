# SmartOps SOC — environment template.
#
# Copy to `.env` in the REPO ROOT (next to this file) and fill in. `.env` is
# gitignored; this file must never hold a real value. Nothing here is required:
# with none of it set, the CLI runs, every family reports honestly why it can't
# answer, and the process exits 0.
#
#   cp .env.example .env
#
# `smartops-broker` loads it automatically, searching upward from the working
# directory (so running from `backend/` works too). A variable already set in
# your shell, CI, or a container WINS over this file -- a stale local .env must
# never override a deployment's real credentials. `--verbose` prints which file
# was loaded, which is the first thing to check when a value "isn't picked up".


# ── Model provider ────────────────────────────────────────────────────────────
#
# The Tool Broker uses Anthropic's API. `none` turns the Broker's model off.
# Bedrock credentials below are reserved for the Foundation analyst; they do not
# select a Broker model.
SMARTOPS_LLM_PROVIDER=anthropic

# --- Anthropic API (Broker tiers) ---
# ANTHROPIC_API_KEY=
# Tier preset per Broker role (A/B test):
#   A: broker claude-opus-5-5/high, siem claude-sonnet-5-5/medium, vt claude-haiku-5-5/low
#   B: broker claude-sonnet-5-5/high, siem claude-haiku-5-5/medium, vt claude-haiku-5-5/low
# SMARTOPS_BROKER_TIERS=A
# Per-role overrides win over the preset:
# SMARTOPS_MODEL_ID_BROKER= / SMARTOPS_MODEL_ID_SIEM= / SMARTOPS_MODEL_ID_VT=
# SMARTOPS_EFFORT_BROKER= / SMARTOPS_EFFORT_SIEM= / SMARTOPS_EFFORT_VT=


# ── Splunk (siem family, over MCP) ────────────────────────────────────────────
#
# Referenced as ${VAR} from mcp_servers.json, so no secret lives in the repo.
# Unset means the server is skipped and `siem` reports "no MCP server
# configured" -- not a crash.
SPLUNK_MCP_URL=https://splunk.example.com:8089/services/mcp
SPLUNK_TOKEN=<your-splunk-token>

# Point at a different mcpServers config (default: ./mcp_servers.json)
# SMARTOPS_MCP_CONFIG=/etc/smartops/mcp_servers.json


# ── VirusTotal (vt family, REST) ──────────────────────────────────────────────
#
# Free tier allows ~4 requests/minute; lookups run sequentially because of it.
# Unset means `vt` reports the missing key rather than failing.
VT_API_KEY=<your-vt-key>


# ── Observability ─────────────────────────────────────────────────────────────
#
# Nothing is exported by default: Strands' GenAI spans can carry prompt and
# response content, and this is a SOC tool.
#
# Point at any OTLP collector (Langfuse, Phoenix, CloudWatch) to enable export.
# Langfuse is auto-detected from the endpoint and needs no code change.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ⚠️ Set this before enabling any exporter. Strands' span-content redaction is
# OPT-IN and off by default -- absent this, prompts and responses are exported
# verbatim. An empty value after the `=` means "redact everything sensitive".
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_unredacted_attributes=

# TLS verification disabled for the lab Splunk box (stock SplunkServerDefaultCert,
# no SAN). Decision recorded 2026-08-11.
SMARTOPS_MCP_TLS_NO_VERIFY=splunk

# ── Subagent-analysts model (Foundation-Sec-8B-Reasoning, Bedrock import) ─────
# The identity/network/endpoint analysts run on the Bedrock custom-imported
# Cisco model, invoked via raw invoke_model. Fill in the ARN + credential.
# Leaving the ARN empty simply skips the analysis step.
AWS_REGION=us-east-1
SMARTOPS_ANALYST_MODEL_ARN=arn:aws:bedrock:us-east-1:<acct>:imported-model/<id>
# ABSK... bearer token, or ACCESS_KEY_ID:SECRET_ACCESS_KEY[:SESSION_TOKEN].
# Leave empty to use the default AWS credential chain.
SMARTOPS_ANALYST_API_KEY=ABSK...
# Optional generation controls (defaults: 0.3 / 0.95 / 3072).
# Temperature was 0.6 -- the model's own generation_config value, which is its
# CONVERSATIONAL default. Measured at 0.6 the same evidence gave three of the four
# dispositions across five draws (confidence spread 0.60, citation Jaccard 0.27); see
# docs/sessions/handover_2026-08-27_analyst-verdict-variance.md. 0.3 is the model
# card's own eval setting. Set 0 for byte-identical draws, at the cost of thinner
# reads; the prompt's reporting floor is what keeps a low temperature honest.
SMARTOPS_ANALYST_TEMPERATURE=0.3
SMARTOPS_ANALYST_TOP_P=0.95
SMARTOPS_ANALYST_MAX_GEN_LEN=3072
SMARTOPS_SKILLS_ENABLED=true

# ── SIEM index allowlist (indexes the siem subagent may search, comma list) ──
# notable and risk (Splunk ES detection records) are always rejected, even if listed.
SMARTOPS_SIEM_INDEXES=windows_lab,main

# ── OpenCTI (optional threat intel, read by webapp/main.py) ───────────────────
# GraphQL endpoint of your OpenCTI instance. Unset falls back to
# http://localhost:8080/graphql, which is NOT OpenCTI on this machine.
OPENCTI_URL=http://<opencti-host>:8080/graphql
OPENCTI_TOKEN=<your-opencti-token>
