# SmartOps SOC — Unified Environment
# Copy this to .env and fill in your values

# ── Foundation-Sec-8B-Reasoning (Analyst + Synthesis LLM) ────────────────────
# The imported model ARN from Bedrock console
FS8B_MODEL_ARN=arn:aws:bedrock:us-east-1:<acct>:imported-model/<id>

# ABSK bearer token (starts with ABSK...)
FS8B_API_KEY=ABSK...

# AWS region (must match region in the ARN above)
AWS_REGION=us-east-1

# ── Task Broker LLM (Claude Sonnet on Bedrock) ────────────────────────────────
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-XXXXXXXX-v1:0

# ── Splunk MCP (Task Broker Subagents) ───────────────────────────────────────
SPLUNK_MCP_URL=https://splunk.example.com:8089/services/mcp
SPLUNK_TOKEN=<your-splunk-token>
SMARTOPS_MCP_TLS_NO_VERIFY=splunk

# ── VirusTotal ────────────────────────────────────────────────────────────────
VT_API_KEY=<your-vt-key>

# ── OpenCTI (optional) ────────────────────────────────────────────────────────
OPENCTI_URL=http://localhost:8080/graphql
OPENCTI_TOKEN=607c0c8e-ba29-4e00-9d6b-8e33e33d0f92
